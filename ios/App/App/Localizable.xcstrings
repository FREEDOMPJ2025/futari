    "Opens Futari's Add entry screen with the amount, note and category filled in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Futari's Add entry screen with the amount, note and category filled in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Futari の記録画面を開き、金額・メモ・カテゴリーを入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Futari 的记一笔画面，带入金额、备注与分类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Futari 的記一筆畫面，帶入金額、備註與分類。"
